# Copying this file is not sufficient: configure.py creates a random secret and hashed code.
DOMAIN=listen.example.com
APP_ORIGIN=https://listen.example.com
ACME_EMAIL=admin@example.com
SESSION_SECRET=GENERATE_WITH_scripts_configure_py
ACCESS_CODE_HASH=GENERATE_WITH_scripts_configure_py
MODEL_LICENSES_ACK=0
ASR_MODE=dual
# cpu is portable. cuda requires a CUDA-enabled sherpa-onnx build and a GPU node.
ASR_PROVIDER=cpu
TTS_ENABLED=1
MODEL_DIR=/models
ASR_THREADS=3
MAX_LIVE_SESSIONS=2
APP_MEMORY=12g
MAX_UPLOAD_MB=50
MAX_UPLOAD_SECONDS=600
MAX_SESSION_SECONDS=1800
COOKIE_DAYS=30
VAD_SILENCE=0.7
SEGMENT_SECONDS=12
PARTIAL_INTERVAL=1.8
INFERENCE_TIMEOUT=120
NANO_HOTWORDS=
# Set MODEL_BASE_URL only for a mirror controlled and vetted by your administrator.
# The downloader appends /asr-models/<artifact> or /tts-models/<artifact>.
MODEL_BASE_URL=
